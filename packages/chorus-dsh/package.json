{
  "name": "@chorus-aidlc/chorus-dsh",
  "version": "0.17.0",
  "description": "Chorus lifecycle, MCP, prompt, and skill bundle for DeepSeek Harness",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/Chorus-AIDLC/Chorus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chorus-AIDLC/Chorus.git",
    "directory": "packages/chorus-dsh"
  },
  "keywords": [
    "chorus",
    "deepseek-harness",
    "dsh",
    "mcp",
    "ai-dlc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "chorus-dsh-mcp-call": "bin/chorus-mcp-call.mjs"
  },
  "main": "dist/chorus-dsh.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/chorus-dsh.mjs"
    },
    "./persona": {
      "types": "./dist/persona.d.ts",
      "default": "./dist/persona.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run check:package",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/chorus-dsh.mjs && esbuild src/persona.ts --bundle --platform=node --format=esm --target=node20 --external:@deepseek-ai/dsh-persona --outfile=dist/persona.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src tests contract vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "check:dsh-contract": "bash scripts/check-dsh-contract.sh",
    "check:package": "node scripts/validate-package.mjs",
    "check:pack": "bash scripts/check-pack.sh",
    "test:dsh-smoke": "bash scripts/test-real-dsh.sh"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-persona": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-skill": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-persona": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/node": "^22",
    "esbuild": "^0.27.7",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
