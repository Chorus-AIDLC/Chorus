---
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="integration" id="integration">
  <div class="section-header">
    <div class="section-label">{t(lang, 'integration.label')}</div>
    <h2>{t(lang, 'integration.title')}</h2>
    <p>{t(lang, 'integration.subtitle')}</p>
  </div>
  <div class="integration-grid">
    <div class="int-card">
      <div class="int-icon int-icon-plugin">
        <img src="/images/claudecode.png" alt="Claude Code" width="28" height="28" />
      </div>
      <h3>{t(lang, 'integration.claudeCode.title')}</h3>
      <p>{t(lang, 'integration.claudeCode.description')}</p>
      <div class="int-hooks">
        <span class="int-hook">/chorus</span>
        <span class="int-hook">/develop</span>
        <span class="int-hook">/proposal</span>
        <span class="int-hook">/yolo</span>
        <span class="int-hook">3 Reviewers</span>
        <span class="int-hook">13 Hooks</span>
      </div>
      <div class="int-code">
        <span class="comment">{t(lang, 'integration.claudeCode.installComment')}</span><br>
        <span class="cmd">claude</span> <span class="flag">/plugin marketplace add</span> Chorus-AIDLC/chorus<br>
        <span class="cmd">claude</span> <span class="flag">/plugin install</span> chorus@chorus-plugins
      </div>
    </div>
    <div class="int-card">
      <div class="int-icon int-icon-codex">
        <img src="/images/codex-logo.png" alt="Codex" width="28" height="28" />
      </div>
      <h3>{t(lang, 'integration.codex.title')}</h3>
      <p>{t(lang, 'integration.codex.description')}</p>
      <div class="int-hooks">
        <span class="int-hook">$chorus</span>
        <span class="int-hook">$develop</span>
        <span class="int-hook">$proposal</span>
        <span class="int-hook">$yolo</span>
        <span class="int-hook">3 Reviewers</span>
        <span class="int-hook">Hooks</span>
      </div>
      <div class="int-code">
        <span class="comment">{t(lang, 'integration.codex.installComment')}</span><br>
        <span class="cmd">chorus</span> <span class="flag">agents add</span> --agents codex
      </div>
    </div>
    <div class="int-card">
      <div class="int-icon int-icon-openclaw">
        <img src="/images/openclaw.png" alt="OpenClaw" style="height:28px;width:auto;" />
      </div>
      <h3>{t(lang, 'integration.openclaw.title')}</h3>
      <p>{t(lang, 'integration.openclaw.description')}</p>
      <div class="int-hooks">
        <span class="int-hook">SSE Push</span>
        <span class="int-hook">MCP Bridge</span>
        <span class="int-hook">Embedded Agent</span>
        <span class="int-hook">Interrupt / Resume</span>
        <span class="int-hook">12 Skills</span>
      </div>
      <div class="int-code">
        <span class="comment">{t(lang, 'integration.openclaw.installComment')}</span><br>
        <span class="cmd">openclaw</span> <span class="flag">plugins install</span> @chorus-aidlc/chorus-openclaw-plugin
      </div>
    </div>
    <div class="int-card">
      <div class="int-icon int-icon-skill">
        <svg width="24" height="24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
      </div>
      <h3>{t(lang, 'integration.skills.title')}</h3>
      <p>{t(lang, 'integration.skills.description')}</p>
      <div class="int-hooks">
        <span class="int-hook">chorus</span>
        <span class="int-hook">idea</span>
        <span class="int-hook">proposal</span>
        <span class="int-hook">develop</span>
        <span class="int-hook">quick-dev</span>
        <span class="int-hook">review</span>
      </div>
      <div class="int-code">
        <span class="comment">{t(lang, 'integration.skills.installComment')}</span><br>
        <span class="cmd">curl</span> <span class="flag">-sL</span> &lt;CHORUS_URL&gt;/skill/chorus/SKILL.md
      </div>
    </div>
  </div>
</div>

<style>
  .integration {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    border-radius: 24px;
    padding: 80px 48px;
    margin: 100px 32px 0;
    max-width: 1200px;
    margin-left: auto; margin-right: auto;
  }
  .integration :global(.section-header) { margin-bottom: 48px; }
  .integration :global(.section-label) { color: #7dd3fc; }
  .integration :global(.section-header h2) { color: #fff; }
  .integration :global(.section-header p) { color: rgba(255,255,255,0.6); }
  .integration-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .int-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius);
    padding: 32px;
    transition: all 0.25s;
  }
  .int-card:hover {
    background: rgba(255,255,255,0.1);
    transform: translateY(-2px);
  }
  .int-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    font-size: 22px;
  }
  .int-icon-plugin { background: rgba(125, 211, 252, 0.15); }
  .int-icon-skill { background: rgba(52, 211, 153, 0.15); }
  .int-icon-codex { background: rgba(255, 255, 255, 0.12); }
  .int-icon-openclaw {
    background: rgba(249, 115, 22, 0.15);
    width: auto;
    padding: 8px 16px;
  }
  .int-card h3 {
    font-size: 18px; font-weight: 700;
    color: #fff;
    margin-bottom: 10px;
  }
  .int-card p {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    line-height: 1.65;
    margin-bottom: 16px;
  }
  .int-hooks {
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .int-hook {
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px; font-weight: 600;
    font-family: 'SF Mono', 'Fira Code', monospace;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .int-code {
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 16px 20px;
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 13px;
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
    overflow-x: auto;
    margin-top: 16px;
  }
  .int-code .cmd { color: #7dd3fc; }
  .int-code .flag { color: #a78bfa; }
  .int-code .comment { color: rgba(255,255,255,0.3); }

  @media (max-width: 900px) {
    .integration { padding: 36px 20px; margin: 60px 16px 0; border-radius: 16px; }
    .integration-grid { grid-template-columns: 1fr; }
    .int-card { padding: 24px; }
    .int-code { font-size: 11px; padding: 12px 14px; word-break: break-all; }
  }
  @media (max-width: 480px) {
    .integration { padding: 28px 16px; margin: 40px 12px 0; }
    .int-card { padding: 20px; }
    .int-hooks { gap: 6px; }
    .int-hook { font-size: 11px; padding: 4px 8px; }
  }
</style>
